# Application title.
APP_NAME=Takumi Knowledge Engine
# Direct browser-playable course recording. Empty until a recording is supplied.
COURSE_VIDEO_URL=
# Actual recording duration, used by server-side watch progress tracking.
COURSE_VIDEO_DURATION_SECONDS=60
# Deployment environment; production forbids demo capabilities.
APP_ENV=development
# SQLite file initialized on startup.
DATABASE_URL=sqlite:///./data/takumi.db
# Enable development demo identities and data.
DEMO_MODE=true
# Enable signed demo login.
ENABLE_DEMO_AUTH=true
# Seed missing fixture task on startup without overwriting edits.
ENABLE_DEMO_SEED=true
# Allow reviewer-confirmed fixture reset.
ENABLE_DEMO_RESET=true
# Fresh databases start with release_001 approved.
DEMO_SEED_STATE=approved_baseline
# Answer only from active release snapshots.
ENABLE_GROUNDED_QA=true
# Export immutable training packs.
ENABLE_TRAINING_PACK_EXPORT=true
# Empty means generated per process; tokens expire on restart.
DEMO_SIGNING_SECRET=
# Token lifetime in minutes (1–1440).
DEMO_TOKEN_TTL_MINUTES=480
# fixture: deterministic Q&A/gaps; gemini, ollama or openrouter enables worker extraction.
AI_PROVIDER=fixture
# Enable Gemini or Ollama extraction; requires ENABLE_MEDIA_PROCESSING=true.
ENABLE_LIVE_EXTRACTION=false
# Live Gemini contextual clarification generation (POST .../clarifications/generate); requires AI_PROVIDER=gemini.
ENABLE_LIVE_GAP_GENERATION=false
# Live Gemini grounded Q&A over the active release; requires AI_PROVIDER=gemini plus support validation and abstention.
ENABLE_LIVE_QA=false
# Exact approved-field check on every Q&A claim; must stay true when ENABLE_LIVE_QA=true.
ENABLE_QA_SUPPORT_VALIDATION=true
# Abstain when approved knowledge does not support an answer; must stay true when ENABLE_LIVE_QA=true.
ENABLE_QA_ABSTENTION=true
# Record usage/latency on gap runs and append grounded Q&A call-log rows (no raw questions or prompts).
ENABLE_AI_EVAL_LOGGING=true
# Fall back to labelled deterministic questions when live gap generation fails.
ENABLE_DETERMINISTIC_GAP_FALLBACK=true
# required when AI_PROVIDER=gemini; must be a video-capable model available to your key (not verified by this repo).
GEMINI_API_KEY=
# Gemini 3-series video-capable model required when AI_PROVIDER=gemini.
GEMINI_MODEL=gemini-3.5-flash-lite
# required when AI_PROVIDER=ollama
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=
# WHISPER_BASE_URL=
# required when AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# Comma-separated fallback list; OpenRouter tries the next model when one errors.
# OPENROUTER_MODEL=xingchen-agi/xing4.0-29b-a4b:free,nvidia/nemotron-3.5-super-vl:free,openrouter/free
# Accept validated MP4 uploads (requires ffprobe on PATH).
ENABLE_MEDIA_UPLOAD=false
# Accept durable processing jobs; requires ENABLE_MEDIA_UPLOAD=true.
ENABLE_MEDIA_PROCESSING=false
# Enable authenticated and signed-token playback.
ENABLE_MEDIA_STREAMING=false
# Upload size limit in MiB.
MAX_UPLOAD_MB=100
# Maximum recording duration in seconds.
MAX_VIDEO_DURATION_SECONDS=240
# Run the separate worker; requires ENABLE_MEDIA_PROCESSING=true.
ENABLE_PROCESSING_WORKER=false
# Retries after the first attempt.
PROCESSING_MAX_RETRIES=2
# Maximum jobs with active leases across workers.
PROCESSING_MAX_CONCURRENT_JOBS=1
MEDIA_STORAGE_DIR=./data/media
PROCESSING_POLL_INTERVAL_SECONDS=2
# Lease must exceed provider timeout.
PROCESSING_JOB_LEASE_SECONDS=180
# HTTP I/O timeout; also a shared FFmpeg/Whisper deadline and an OpenRouter chat deadline.
PROCESSING_PROVIDER_TIMEOUT_SECONDS=120
# reserved: Checkpoint 6, must stay false in V1.
ENABLE_MULTILINGUAL=false
# reserved: Checkpoint 6, must stay false in V1.
ENABLE_EMBEDDINGS=false
# reserved: Checkpoint 6, must stay false in V1.
ENABLE_ADVANCED_RETRIEVAL=false
# Standard library logging level.
LOG_LEVEL=INFO
# reserved: must stay false.
ENABLE_AI_VIVA_SCORING=false
# reserved: Checkpoint 6, must stay false.
LOG_MODEL_INPUTS=false
# Comma-separated allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Maximum declared request body size in KB.
MAX_REQUEST_BODY_KB=1024

# Live-mode example: set a real key/model above and uncomment these overrides.
# AI_PROVIDER=gemini
# ENABLE_MEDIA_UPLOAD=true
# ENABLE_MEDIA_STREAMING=true
# ENABLE_MEDIA_PROCESSING=true
# ENABLE_LIVE_EXTRACTION=true
# ENABLE_PROCESSING_WORKER=true
# ENABLE_LIVE_GAP_GENERATION=true
# ENABLE_LIVE_QA=true

# Studio source-note diagnosis: GEMINI_API_KEY enables live agents automatically.
ENABLE_STUDIO_AI_ANALYSIS=true
# Overrides GEMINI_MODEL for Studio only; leave unset to reuse GEMINI_MODEL.
STUDIO_AI_MODEL=gemini-3.5-flash-lite
STUDIO_AI_TIMEOUT_SECONDS=60
# Reasoning level for source extraction and patch review. With gemini-3.5-flash-lite,
# `low` observed only the opening seconds of a 230 s video; `medium` reached its end.
STUDIO_AI_THINKING_LEVEL=medium
